# MyStock - variables del frontend (Vite)
# Copia a frontend/.env.local para cambiarlas en local.
# Se leen al hacer "npm run dev" / "npm run build" (quedan dentro del
# bundle: nunca pongas secretos aquí).

# URL del backend. Por defecto http://127.0.0.1:5000
# Producción, p. ej.: VITE_API_URL=https://mystock-api.up.railway.app
VITE_API_URL=
