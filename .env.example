# =========================================================
# MyStock - variables de entorno del backend
# =========================================================
# En local: copia este fichero a backend/.env (o .env en la raíz)
# y ajusta lo que necesites. Todo es opcional en desarrollo.
# En producción (Railway): define estas variables en el panel
# del servicio; no subas nunca un .env al repositorio.
# =========================================================

# development (por defecto) | production
# En production la API NO arranca sin JWT_SECRET_KEY y DATABASE_URL.
APP_ENV=development

# Local: SQLite (fichero en backend/instance/mystock.db).
# Producción: PostgreSQL. En Railway usa la referencia
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Se aceptan postgres://, postgresql:// y postgresql+psycopg://.
DATABASE_URL=sqlite:///mystock.db

# Clave para firmar los tokens de sesión (mínimo 32 caracteres).
# Obligatoria en producción. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# En desarrollo, si se deja vacía, se usa una clave de prueba.
JWT_SECRET_KEY=

# Duración de la sesión en horas.
JWT_ACCESS_TOKEN_HOURS=12

# Orígenes del frontend que pueden llamar a la API, separados por comas.
# Vacío en desarrollo = servidor de Vite (localhost:5173 y 127.0.0.1:5173).
# Producción, p. ej.: CORS_ORIGINS=https://mystock.vercel.app
CORS_ORIGINS=
